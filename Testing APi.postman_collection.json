{
  "info": {
    "_postman_id": "7a043628-2ed4-4206-b5cc-cb853082d047",
    "name": "Testing APi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pos",
      "item": [
        {
          "name": "Authenization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Đăng nhập thành công (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set(\"token\", jsonData.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/auth",
              "protocol": "https",
              "host": ["restful-booker", "herokuapp", "com"],
              "path": ["auth"]
            }
          },
          "response": []
        },
        {
          "name": "Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Tên khách hàng khớp với dữ liệu\", function () {",
                  "        var expectedFirstName = pm.iterationData.get(\"firstname\") || \"Jim\";",
                  "        pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);",
                  "    });",
                  "    pm.environment.set(\"bookingid\", jsonData.bookingid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{firstname}}\",\n    \"lastname\": \"{{lastname}}\",\n    \"totalprice\": 111,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-01-01\",\n        \"checkout\": \"2026-01-02\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}"
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": ["restful-booker", "herokuapp", "com"],
              "path": ["booking"]
            }
          },
          "response": []
        },
        {
          "name": "Get",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lấy thông tin booking thành công (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking/{{bookingid}}",
              "protocol": "https",
              "host": ["restful-booker", "herokuapp", "com"],
              "path": ["booking", "{{bookingid}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Xóa booking thành công (Status 201)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking/{{bookingid}}",
              "protocol": "https",
              "host": ["restful-booker", "herokuapp", "com"],
              "path": ["booking", "{{bookingid}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
